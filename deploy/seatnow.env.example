# Copy to deploy/seatnow.env (that file is git-ignored: it holds the camera password).
# One line per setting, no quotes needed unless the value has spaces.

# Camera stream. Hikvision main stream is /Streaming/Channels/101.
#   real camera:  rtsp://admin:PASSWORD@192.168.0.50:554/Streaming/Channels/101
#   test bench:   rtsp://127.0.0.1:8554/seatnow   (edge/fake_camera.sh)
SEATNOW_URL=rtsp://127.0.0.1:8554/seatnow

# Seat layout drawn with install/calibrate.py for THIS camera's view.
SEATNOW_LAYOUT=layouts/cafe_angle1.json

# Days of JSONL to keep under results/live (0 = keep forever).
SEATNOW_KEEP_DAYS=14

# Extra flags, space separated (usually empty). e.g. --hwaccel none
SEATNOW_EXTRA=

# Supabase 전송 (다섯 줄이 다 있어야 켜진다. 하나라도 비면 전송은 꺼지고 판정만 돈다).
#   CAFE_ID   : Supabase `cafes.id` 와 같은 짧은 이름
#   URL/ANON  : Supabase 대시보드 → Settings → API 의 Project URL, anon public key
#   EMAIL/PW  : 이 박스용으로 만든 Supabase 인증 사용자 (docs/앱연동.md "박스 계정")
SEATNOW_CAFE_ID=
SEATNOW_SUPABASE_URL=
SEATNOW_SUPABASE_ANON_KEY=
SEATNOW_SUPABASE_EMAIL=
SEATNOW_SUPABASE_PASSWORD=
